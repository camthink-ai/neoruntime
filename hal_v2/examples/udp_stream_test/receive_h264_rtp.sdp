; Minimal SDP for hal-udp-stream-test (H.264, RTP PT 96, clock 90 kHz).
; Edit the port in "m=video <port>" to match the port you pass to hal-udp-stream-test.
;
; Receiver (PC), from this directory (hal_v2/examples/udp_stream_test):
;   ffplay -protocol_whitelist file,rtp,udp -fflags nobuffer -flags low_delay -i receive_h264_rtp.sdp
;
v=0
o=- 0 0 IN IP4 127.0.0.1
s=hal H264 RTP
c=IN IP4 0.0.0.0
t=0 0
m=video 5555 RTP/AVP 96
a=rtpmap:96 H264/90000
a=fmtp:96 packetization-mode=1
