# AIPC Python 基础镜像
# 预装 AIPC SDK 和常用依赖
#
# 构建命令:
#   docker build -f Dockerfile.python-base -t aipc/python-base:1.0 .
#
# 使用方法:
#   FROM aipc/python-base:1.0

FROM python:3.9-slim

LABEL maintainer="AIPC Team"
LABEL description="AIPC Python base image with SDK pre-installed"
LABEL version="1.0"

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# 复制并安装 SDK
COPY sdk/hailo_ipc_sdk-*.whl /tmp/
RUN pip install --no-cache-dir /tmp/hailo_ipc_sdk-*.whl \
    && rm -f /tmp/hailo_ipc_sdk-*.whl

# 创建非 root 用户
RUN useradd -m -u 1000 appuser

# 设置工作目录
WORKDIR /app

# 默认使用非 root 用户
USER appuser

ENV PYTHONUNBUFFERED=1
