# Environment Variables Example
# Copy this file to web/.env and adjust the values for your setup:
#   cp web/.env.example web/.env
# (web/.env is gitignored, so local hosts/secrets stay local.)
# You can also create web/.env.local to override individual settings.

# ==============================================================================
# API Configuration
# ==============================================================================
# Relative API base path used by the frontend. In dev the Vite proxy handles
# routing, so keep this as a relative path.
VITE_API_BASE_URL=/api/v1
# API token, if your backend requires one (leave empty otherwise).
VITE_API_TOKEN=

# ==============================================================================
# Backend target (for the Vite dev proxy)
# - LOCAL:  backend running on WSL / this machine (default)
# - REMOTE: remote device or server
# To switch, uncomment one block under "Active config" and comment out the other.
# ==============================================================================

# --- Active config: LOCAL ---
VITE_API_TARGET=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/api/v1/ws
VITE_VIDEO_STREAM_URL=ws://localhost:8080/api/v1/h264/main

# --- REMOTE template (replace <your-device-ip> with your device/server IP) ---
# VITE_API_TARGET=https://<your-device-ip>
# VITE_WS_URL=wss://<your-device-ip>/api/v1/ws
# VITE_VIDEO_STREAM_URL=wss://<your-device-ip>/api/v1/h264/main

# ==============================================================================
# Feature Flags
# ==============================================================================
# Set to true to serve mock data instead of calling the real API.
VITE_USE_MOCK_DATA=false
# Set to false to disable the login/auth flow.
VITE_ENABLE_AUTH=true

# ==============================================================================
# Optional (override the Vite defaults in vite.config.ts only if needed)
# ==============================================================================
# Public path the app is served from.
# VITE_APP_BASE=/
# Set to true to serve dev over HTTPS with a trusted self-signed cert (mkcert).
# VITE_HTTPS=false
