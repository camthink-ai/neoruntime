[Unit]
Description=AIPC Event Bus Service
Documentation=https://github.com/yourorg/ne503
Wants=aipc-restore.service
Requires=aipc-firstboot.service
After=aipc-restore.service aipc-firstboot.service network.target
Before=ai-runtime.service app-manager.service platform-api.service

[Service]
Type=simple
Environment=AIPC_APP_MANIFEST=/data/aipc/app-manifest.json
ExecStartPre=/bin/mkdir -p /data/logs /data/aipc/logs /run/aipc
ExecStartPre=/bin/sh -c 'if [ -x /usr/libexec/aipc-compat-check ]; then exec /usr/libexec/aipc-compat-check; else echo "aipc-compat-check not installed yet; skip pre-start guard" >&2; fi'
ExecStart=/usr/bin/event-bus -config /data/aipc/etc/event-bus.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=event-bus

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
