[Unit]
Description=AIPC Device Control Service
Documentation=https://github.com/yourorg/ne503
Wants=aipc-restore.service camera-daemon.service
Requires=aipc-firstboot.service
After=aipc-restore.service aipc-firstboot.service aipc-mcu-prep.service camera-daemon.service network.target
Wants=network-online.target

[Service]
Type=simple
Environment=AIPC_APP_MANIFEST=/data/aipc/app-manifest.json
ExecStartPre=/bin/mkdir -p /data/logs /data/aipc/logs /run/aipc
ExecStartPre=/bin/sh -c 'if [ -x /usr/libexec/aipc-compat-check ]; then exec /usr/libexec/aipc-compat-check; else echo "aipc-compat-check not installed yet; skip pre-start guard" >&2; fi'
ExecStart=/usr/bin/device-control -config /data/aipc/etc/device-control.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=device-control

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
