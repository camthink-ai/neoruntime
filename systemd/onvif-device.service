[Unit]
Description=AIPC ONVIF Device Service
Documentation=https://github.com/camthink-ai/ne503-aipc
Wants=aipc-restore.service
Requires=aipc-firstboot.service
After=aipc-restore.service aipc-firstboot.service network.target camera-daemon.service

[Service]
Type=simple
Environment=AIPC_APP_MANIFEST=/data/aipc/app-manifest.json
ExecStartPre=/bin/mkdir -p /data/aipc/logs /run/aipc
ExecStart=/usr/bin/onvif-device --config /data/aipc/etc/onvif.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=onvif-device

[Install]
WantedBy=multi-user.target
