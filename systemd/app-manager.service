[Unit]
Description=AIPC App Manager Service
Documentation=https://github.com/yourorg/ne503
Wants=aipc-restore.service
Requires=aipc-firstboot.service
After=aipc-restore.service aipc-firstboot.service network.target containerd.service
Wants=containerd.service ai-runtime.service event-bus.service

[Service]
Type=simple
Environment=AIPC_APP_MANIFEST=/data/aipc/app-manifest.json
Environment=AIPC_TOKEN_KEY=aipc-secure-token-secret
ExecStartPre=/bin/mkdir -p /data/aipc/logs /data/aipc/apps /run/aipc
ExecStartPre=/bin/sh -c 'if [ -x /usr/libexec/aipc-compat-check ]; then exec /usr/libexec/aipc-compat-check; else echo "aipc-compat-check not installed yet; skip pre-start guard" >&2; fi'
ExecStart=/usr/bin/app-manager -config /data/aipc/etc/app-manager.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=app-manager

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
