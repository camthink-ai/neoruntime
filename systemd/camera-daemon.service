[Unit]
Description=AIPC Camera Daemon Service
Documentation=https://github.com/yourorg/ne503
Wants=aipc-restore.service isp_media_server.service hailort_server.service
Requires=aipc-firstboot.service
After=aipc-restore.service aipc-firstboot.service aipc-mcu-prep.service network.target isp_media_server.service hailort_server.service
Before=ai-runtime.service

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=120
Environment=AIPC_APP_MANIFEST=/data/aipc/app-manifest.json
WorkingDirectory=/data/aipc/logs
ExecStartPre=/bin/mkdir -p /home/root/.hailo /data/aipc/logs /run/aipc
ExecStartPre=/bin/sh -c 'if [ -x /usr/libexec/aipc-compat-check ]; then exec /usr/libexec/aipc-compat-check; else echo "aipc-compat-check not installed yet; skip pre-start guard" >&2; fi'
# Strip Hailo demo OSD and stamp the NE503 text logo (top-left) onto the active
# medialib profile before the pipeline loads it. Idempotent self-heal across
# redeploy/reflash/restart. Helper is best-effort (never blocks startup); the
# guard keeps camera-daemon startable when the helper is not yet installed.
ExecStartPre=/bin/sh -c 'if [ -x /usr/libexec/aipc-osd-apply ]; then exec /usr/libexec/aipc-osd-apply; else echo "aipc-osd-apply not installed yet; skip OSD patch" >&2; fi'
ExecStart=/usr/bin/camera-daemon -c /data/aipc/etc/camera-daemon.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camera-daemon

# medialib dewarp optimization.
# NOTE: DSP path (=1) deadlocks the ISP after ~20-30min of continuous run ->
# kernel-level hard freeze (NO panic/oops/OOM, just silence mid-heartbeat) ->
# sp805 watchdog hard reset -> periodic boot-loop.
# Confirmed on 93.72 (Hailo15, IMX678) 2026-06-17: =0 runs stable 34min+ past the
# 28.5min death point (healthy 30fps, 0 drops). Default =0 to avoid the freeze.
# Revisit when medialib/BSP fixes the DSP deadlock; if DSP dewarp becomes
# functionally required, isolate it or gate it behind a per-device override.
Environment="MEDIALIB_DEWARP_DSP_OPTIMIZATION=0"

# Resource limits
LimitNOFILE=65536
LimitCORE=infinity

[Install]
WantedBy=multi-user.target
